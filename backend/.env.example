# Copia este archivo a .env y rellena los valores. Nunca subas el .env al repositorio.

# Cadena de conexión a PostgreSQL (local con Docker o Neon)
DATABASE_URL=postgresql://clinica_user:clinica_password@localhost:5433/sysgest_db_demo

# Secreto para firmar los JWT. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
# Duración de la sesión en horas (opcional, por defecto 8)
JWT_TTL_HOURS=8

# Orígenes permitidos por CORS, separados por comas (opcional)
# CORS_ORIGINS=https://cl-nica-remes-banz.onrender.com,http://localhost:5173

# Habilita /docs y /openapi.json (solo desarrollo)
ENABLE_DOCS=false

# Cloudinary (fotos de perfil)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
